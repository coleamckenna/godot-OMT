[configuration]

entry_symbol = "godot_omt_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/linux/godot_omt.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/godot_omt.linux.template_release.x86_64.so"
macos.debug = "res://bin/macos/godot_omt.macos.template_debug.universal.dylib"
macos.release = "res://bin/macos/godot_omt.macos.template_release.universal.dylib"
windows.debug.x86_64 = "res://bin/windows/godot_omt.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/godot_omt.windows.template_release.x86_64.dll"
