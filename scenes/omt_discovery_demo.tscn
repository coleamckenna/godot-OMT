[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/omt_discovery_demo.gd" id="1_discovery"]

[node name="OMTDiscoveryDemo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_discovery")

[node name="OMTDiscovery" type="OMTDiscovery" parent="."]

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 18.0
offset_top = 18.0
offset_right = -18.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Layout/Header"]
layout_mode = 2
text = "Back"

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "OMT Source Discovery"
horizontal_alignment = 1

[node name="RefreshButton" type="Button" parent="Layout/Header"]
layout_mode = 2
text = "Refresh Now"

[node name="Description" type="Label" parent="Layout"]
layout_mode = 2
text = "OMTDiscovery wraps source refreshes and emits source_added, source_removed, and sources_changed signals."
autowrap_mode = 3

[node name="Body" type="HBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="SourcesPanel" type="PanelContainer" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="Layout/Body/SourcesPanel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="SourcesList" type="ItemList" parent="Layout/Body/SourcesPanel/Margin"]
layout_mode = 2

[node name="EventPanel" type="PanelContainer" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="Layout/Body/EventPanel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="EventLog" type="RichTextLabel" parent="Layout/Body/EventPanel/Margin"]
layout_mode = 2
bbcode_enabled = false
text = "Discovery events appear here.\n"
fit_content = true
scroll_following = true

[node name="StatusLabel" type="Label" parent="Layout"]
layout_mode = 2
text = "Waiting for discovery..."
autowrap_mode = 3
